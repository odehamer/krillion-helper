{
  "manifest_version": 3,
  "name": "Krillion Helper",
  "version": "6.0",
  "description": "Shows rare answers for each Krillion prompt using Claude.",
  "action": { "default_popup": "popup.html", "default_title": "Krillion Helper" },
  "options_page": "options.html",
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://*.krillion.org/*",
    "https://*.krillion.io/*",
    "https://*.krillion.lol/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.krillion.org/*", "https://*.krillion.io/*", "https://*.krillion.lol/*"],
      "js": ["ai.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
